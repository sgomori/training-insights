<%#
  The chrome every sidebar block shares. Rendered with `render layout:` so the
  label, spacing and rule live in one place rather than three.
%>
<section>
  <h2 class="font-mono text-xs tracking-[0.18em] text-phosphor uppercase">
    <%= title %>
  </h2>

  <div class="mt-3 border-t border-rule pt-3">
    <%= yield %>
  </div>
</section>
