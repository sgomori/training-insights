# Copy to .env for local development. Never commit .env.
# On Render, set these in the service environment rather than in a file.

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------

# Shared secret for both webhook endpoints. Must match the WEBHOOK_DEST_*_SECRET
# configured on the fit-pipeline instance and in the n8n health-metric workflow.
# Generate with: bin/rails secret
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# MCP server
# ---------------------------------------------------------------------------

# Public URL of this app's MCP endpoint. The website passes this to the Anthropic
# API as an MCP connector target, so it must be publicly reachable — localhost
# will not work. In development, either point it at the deployed instance or
# expose the local server through a tunnel.
MCP_SERVER_URL=https://training.stevegomori.ca/mcp

# API key the website uses to authenticate against its own MCP server.
# Generate real keys with: bin/rails runner 'puts ApiKey.generate!(name: "website")'
MCP_API_KEY=

# Comma-separated hostnames the MCP transport will answer on. The transport's
# DNS rebinding protection rejects anything not named here with a 403, before
# the request reaches a tool. Leave it unset locally — loopback and the host of
# MCP_SERVER_URL are trusted by default. A public deployment must set it to
# every hostname the service answers on, including the platform-assigned one.
# MCP_ALLOWED_HOSTS=training.example.com,my-app.onrender.com

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=

# Model used for visitor-facing chat. Quality matters most here.
ANTHROPIC_CHAT_MODEL=claude-opus-5

# Model used to regenerate pre-generated content after each activity ingestion.
# This fires on every webhook, so it is the cost-sensitive path — consider
# claude-sonnet-5 once real per-call usage has been measured.
ANTHROPIC_CONTENT_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Database (defaults work locally via the peer-authenticated superuser role)
# ---------------------------------------------------------------------------

# DATABASE_URL=postgres://localhost/training_insights_development

# ---------------------------------------------------------------------------
# Deployment (production only — defaults are fine locally)
# ---------------------------------------------------------------------------
#
# render.yaml sets all of these on the canonical instance. They are listed here
# so a deployment on any other platform knows what to set.

# RAILS_ENV=production

# Decrypts config/credentials.yml.enc. Required in production.
# RAILS_MASTER_KEY=

# Caps glibc's per-thread malloc arenas. Left to its default, a threaded Ruby
# process claims arenas it never returns; 2 holds the resident set down on a
# memory-bound instance at a small cost in allocator contention.
# MALLOC_ARENA_MAX=2

# Puma process shape. WEB_CONCURRENCY=0 runs single-process, which is what the
# canonical 512MB instance is sized for — config/puma.rb explains why, and the
# same memory ceiling is why Solid Queue runs in async mode below.
# WEB_CONCURRENCY=0
# RAILS_MAX_THREADS=3
# PORT=3000

# Runs Solid Queue inside Puma rather than as a separate process. Async mode
# runs the supervisor, dispatcher and worker as threads in the web process.
# SOLID_QUEUE_IN_PUMA=true

# Connection pool for the queue database. Sized for the job threads in
# config/queue.yml plus Solid Queue's own supervisor and dispatcher roles;
# raise it alongside those thread counts, never on its own.
# QUEUE_DB_POOL=20

# JOB_CONCURRENCY sets the process count in config/queue.yml. It applies only
# to a standalone `bin/jobs`; embedded async mode forces one process and
# ignores it. Scale with threads instead.

# RAILS_LOG_LEVEL=info
